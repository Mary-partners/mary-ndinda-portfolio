# Postgres connection string.
# Local SQLite dev: "file:./dev.db" (also set provider="sqlite" in schema.prisma).
# Hosted (Supabase, used in production): the Transaction pooler URI, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Secret used to sign the demo session cookie. Any non-empty string works.
SESSION_SECRET=change-me

# One-time seed endpoint token (/api/seed?token=...). Set to a random value.
SEED_TOKEN=

# Shown in the DEMO DATA banner.
NEXT_PUBLIC_APP_ENV=demo
