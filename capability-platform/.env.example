# Postgres connection string.
# Local SQLite dev: "file:./dev.db" (also set provider="sqlite" in schema.prisma).
# Hosted (Supabase, used in production): the Transaction pooler URI, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Secret used to sign the session cookie. Any long random string works.
SESSION_SECRET=change-me

# Token protecting the one-time framework install endpoint (/api/seed?token=...).
SEED_TOKEN=

# Optional. Set to "demo" to show a DEMO badge in the top bar. Leave unset/"production" for a live workspace.
NEXT_PUBLIC_APP_ENV=production
